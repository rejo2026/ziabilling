{
  "name": "zia-billing",
  "version": "1.0.0",
  "description": "Zia-Billing - Enterprise Billing & Invoicing Desktop Management System with Automations",
  "main": "electron/main.cjs",
  "author": "Zia-Billing",
  "scripts": {
    "dev:react": "vite",
    "dev:server": "node server/index.js",
    "build:react": "vite build",
    "package:app": "npm run build:react && npx electron-builder --dir",
    "package:installer": "npm run build:react && npx electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.475.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "sql.js": "^1.15.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.34.8",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-installer-windows": "^3.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.ziabilling.app",
    "productName": "Zia-Billing",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zia-Billing",
      "artifactName": "Zia-Billing-Setup-${version}.${ext}"
    }
  }
}
