# Copy this file to .env (never commit the real .env) and fill in real values
# before deploying anywhere public.

# Port this portal server listens on.
PORTAL_PORT=4300

# Must match the SAME secret the main Zia-Billing app's server/payments/
# gateway.cjs uses (also as PORTAL_SECRET there) — otherwise payment-link
# tokens generated by the main app won't verify here. Use a long random
# string, not the default dev value.
PORTAL_SECRET=change-me-to-a-long-random-secret

# Path to the SAME SQLite database file the main app writes to. For a real
# public deployment this must be reachable from wherever this portal runs —
# e.g. a shared volume/network mount, or (future work) migrating both apps
# to a networked database instead of a local SQLite file.
DB_FILE=../server/data.db

# The public URL this portal will be reachable at once deployed — used when
# the main app builds payment links. Update this to your real domain before
# going live; localhost only works for local testing.
PORTAL_PUBLIC_URL=http://localhost:4300
